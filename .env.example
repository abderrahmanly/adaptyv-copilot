# ---- Agent brain (required) ----
# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ---- Adaptyv Foundry backend ----
# "simulated" (default): free, offline mock that mirrors the real API's shape.
# "real": talk to the live Adaptyv Foundry REST API (needs a token below).
ADAPTYV_MODE=simulated

# Only needed when ADAPTYV_MODE=real.
# Create a token in the Foundry portal (https://foundry.adaptyvbio.com) under
# Organization -> Settings -> Tokens. A **Viewer** token is read-only and is all
# you need to browse the real target catalog and read results.
ADAPTYV_API_TOKEN=
ADAPTYV_API_URL=https://devs.adaptyvbio.com/api/v1

# SAFETY: in real mode, creating and submitting an experiment places a genuine,
# paid lab order. Ordering is refused unless you explicitly opt in here.
# Leave this unset (or false) to keep real mode read-only.
ADAPTYV_ALLOW_ORDERING=false

# ---- Optional: public deployment ----
# Set to require a password before anyone can use the deployed app.
APP_PASSWORD=
