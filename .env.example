# ---- Agent brain (required) ----
# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ---- Adaptyv Foundry backend ----
# "simulated" (default): free, offline mock that mirrors the real API/SDK shape.
# "real": use the official adaptyv-sdk against the live Foundry (needs the vars below + credits).
ADAPTYV_MODE=simulated

# Only needed when ADAPTYV_MODE=real. See https://docs.adaptyvbio.com/api-reference
# Create a token in the Foundry portal under Organization -> Settings -> Tokens.
ADAPTYV_API_KEY=
ADAPTYV_API_URL=https://foundry-api-public.adaptyvbio.com/api/v1
ADAPTYV_ORGANIZATION_ID=
