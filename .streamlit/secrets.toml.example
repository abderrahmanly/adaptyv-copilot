# Streamlit secrets template.
#
# LOCAL:   copy this to .streamlit/secrets.toml (git-ignored) OR just use a .env file.
# DEPLOY:  on Streamlit Community Cloud, paste these into the app's
#          Settings -> Secrets box (do NOT commit real values to GitHub).

# Required — the AI brain. Set a spending cap in the Anthropic console.
ANTHROPIC_API_KEY = "sk-ant-..."

# Keep the lab backend simulated in a public demo (no real assay charges).
ADAPTYV_MODE = "simulated"

# Recommended for a public URL: gate access so only Adaptyv can use it.
# Remove this line to make the app open to anyone with the link.
APP_PASSWORD = "choose-a-password"
